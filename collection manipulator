print("Welcome to the Student Data Organizer!")

students = []

while True:

    print("\n1. Add Student")
    print("2. Display All Students")
    print("3. Update Student Information")
    print("4. Delete Student")
    print("5. Display Subjects offered")
    print("6. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:

        id = int(input("Student ID: "))
        name = input("Name: ")
        age = int(input("Age: "))
        grade = input("Grade: ")
        dob = input("Date of Birth: ")

        s = input("Subjects: ")
        subjects = set(s.split(","))

        info = (id, dob)

        student = {
            "info": info,
            "name": name,
            "age": age,
            "grade": grade,
            "subjects": subjects
        }

        students.append(student)

        print("Student added!")

    elif ch == 2:

        print("\n--- All Students ---")

        for x in students:

            print(
                f"ID: {x['info'][0]}, "
                f"Name: {x['name']}, "
                f"Age: {x['age']}, "
                f"Grade: {x['grade']}, "
                f"Subjects: {x['subjects']}, "
                f"DOB: {x['info'][1]}"
            )

    elif ch == 3:

        id = int(input("Enter Student ID: "))

        for x in students:

            if x["info"][0] == id:

                x["age"] = int(input("Enter new age: "))
                x["grade"] = input("Enter new grade: ")

                print("Student updated!")
                break

    elif ch == 4:

        id = int(input("Enter Student ID: "))

        for x in students:

            if x["info"][0] == id:

                students.remove(x)
                print("Student deleted!")
                break



    elif ch == 5:

        subjects = set()

        for x in students:
            subjects.update(x["subjects"])

        print("\nSubjects Offered:")

        for s in subjects:
            print(s)

    elif ch == 6:

        print("Thank you for using the Student Data Organizer!")
        break

    else:

        print("Wrong choice!")
